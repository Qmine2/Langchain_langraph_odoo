# Copy this file to .env and fill in your values:  cp .env.example .env
# NEVER commit .env (it is already in .gitignore).

# ---- LLM: Groq -------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Any Groq model that supports tool calling: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Tool 1: web search (Tavily) -------------------------------
# Free key at https://app.tavily.com
TAVILY_API_KEY=tvly-your_key_here

# ---- Tool 2: Odoo CRM ------------------------------------------
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database-name
ODOO_USER=you@your-company.com
# Your Odoo password, or better: an API key
# (Odoo > My Profile > Account Security > New API Key)
ODOO_PASSWORD=your_password_or_api_key

# ---- Tool 3: Gmail (Google OAuth) ------------------------------
# OAuth client file downloaded from Google Cloud Console (see README)
GMAIL_CREDENTIALS_FILE=credentials.json
# Created automatically after the first Google login
GMAIL_TOKEN_FILE=token.json
